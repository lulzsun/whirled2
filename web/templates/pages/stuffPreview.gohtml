{{ define "stuffListing" }}
	<div
		id="stuff-listing"
		class="mt-6 pt-3 border-t border-gray-200 dark:border-gray-600 flex flex-col gap-2 text-sm"
	>
		<span class="font-bold text-gray-900 dark:text-white">
			Shop listing
		</span>
		{{ if .HasListing }}
			<p>
				{{ if .IsListed }}
					Listed for
					<span class="font-medium">{{ .Price }} coins</span>
					&middot; {{ .Purchases }} sold
				{{ else }}
					Not currently listed &middot; {{ .Purchases }} sold
				{{ end }}
			</p>
			<div class="flex flex-wrap items-center gap-2">
				<form
					hx-post="/shop/reprice"
					hx-target="#stuff-listing"
					hx-swap="outerHTML"
					hx-push-url="false"
					class="flex items-center gap-2"
				>
					<input
						type="hidden"
						name="listing_id"
						value="{{ .ListingId }}"
					/>
					<input
						type="number"
						name="price"
						value="{{ .Price }}"
						min="0"
						max="1000000"
						class="w-28 p-1.5 text-xs text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
					/>
					<button
						type="submit"
						class="cursor-pointer text-xs font-medium text-white bg-blue-700 hover:bg-blue-800 rounded-lg px-3 py-1.5 dark:bg-blue-600 dark:hover:bg-blue-700"
					>
						Update price
					</button>
				</form>
				<form
					hx-post="{{ .ToggleAction }}"
					hx-target="#stuff-listing"
					hx-swap="outerHTML"
					hx-push-url="false"
				>
					<input
						type="hidden"
						name="listing_id"
						value="{{ .ListingId }}"
					/>
					<button
						type="submit"
						class="cursor-pointer text-xs font-medium text-white bg-orange-600 hover:bg-orange-700 rounded-lg px-3 py-1.5 dark:bg-orange-600 dark:hover:bg-orange-700"
					>
						{{ if .IsListed }}
							Delist
						{{ else }}
							Relist
						{{ end }}
					</button>
				</form>
			</div>
			<p class="text-xs text-gray-500 dark:text-gray-400">
				Repricing and relisting are free; the listing fee was paid when
				the item was first listed.
			</p>
		{{ else }}
			<form
				hx-post="/shop/list"
				hx-target="#stuff-listing"
				hx-swap="outerHTML"
				hx-push-url="false"
				class="flex flex-col gap-2"
			>
				<input type="hidden" name="category" value="{{ .Category }}" />
				<input type="hidden" name="item_id" value="{{ .ItemId }}" />
				<label class="flex items-center gap-2">
					Price
					<input
						type="number"
						name="price"
						value="100"
						min="0"
						max="1000000"
						oninput="document.getElementById('listing-fee').textContent =
							Math.max({{ .FeeMin }}, Math.floor((parseInt(this.value) || 0) * {{ .FeePercent }} / 100))"
						class="w-28 p-1.5 text-xs text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
					/>
					coins
				</label>
				<p class="text-xs text-gray-500 dark:text-gray-400">
					Listing fee:
					<span id="listing-fee">{{ .InitialFee }}</span>
					coins ({{ .FeePercent }}% of the price, minimum
					{{ .FeeMin }}; non-refundable)
				</p>
				<button
					type="submit"
					class="cursor-pointer w-32 text-xs font-medium text-white bg-orange-600 hover:bg-orange-700 rounded-lg px-3 py-1.5 dark:bg-orange-600 dark:hover:bg-orange-700"
				>
					List in shop
				</button>
			</form>
		{{ end }}
	</div>
{{ end }}

{{ define "page" }}
	<div
		class="flex w-full max-w-7xl @7xl/web:w-2/3 gap-4 p-4 @max-2xl/web:flex-col"
	>
		<div class="w-3/5 @max-2xl/web:w-full">
			<div
				class="w-full flex justify-center bg-white font-bold dark:bg-gray-800 rounded-t-lg"
			>
				{{ .Name }}
			</div>
			<div class="h-100">
				{{ template "preview" . }}
			</div>
		</div>
		<div
			class="inline-block w-2/5 @max-2xl/web:w-full text-sm text-gray-500 bg-white border border-gray-200 rounded-lg shadow-sm dark:text-gray-400 dark:bg-gray-800 dark:border-gray-600"
		>
			<div class="p-3">
				<div class="grid grid-cols-3 mb-2">
					<div class="justify-self-start flex flex-row gap-2">
						<a href="#" class="shrink-0">
							<img
								class="w-10 h-10 rounded-full"
								src="/static/assets/profile_picture.png"
								alt="{{ .CreatorUsername }}'s profile picture"
							/>
						</a>
						<div>
							<p
								class="text-base font-semibold leading-none text-gray-900 dark:text-white"
							>
								<a href="#">{{ .CreatorNickname }}</a>
							</p>
							<p class="mb-3 text-sm font-normal">
								<a
									hx-target="#page"
									hx-push-url="true"
									href="/profile/{{ .CreatorUsername }}"
									class="hover:underline"
								>
									@{{ .CreatorUsername }}
								</a>
							</p>
						</div>
					</div>
					<div class="justify-self-center">
						<div
							class="flex justify-center mt-16 @max-2xl/web:mt-0"
						>
							<svg
								class="w-4 h-4 text-yellow-300 me-1"
								aria-hidden="true"
								xmlns="http://www.w3.org/2000/svg"
								fill="currentColor"
								viewBox="0 0 22 20"
							>
								<path
									d="M20.924 7.625a1.523 1.523 0 0 0-1.238-1.044l-5.051-.734-2.259-4.577a1.534 1.534 0 0 0-2.752 0L7.365 5.847l-5.051.734A1.535 1.535 0 0 0 1.463 9.2l3.656 3.563-.863 5.031a1.532 1.532 0 0 0 2.226 1.616L11 17.033l4.518 2.375a1.534 1.534 0 0 0 2.226-1.617l-.863-5.03L20.537 9.2a1.523 1.523 0 0 0 .387-1.575Z"
								/>
							</svg>
							<svg
								class="w-4 h-4 text-yellow-300 me-1"
								aria-hidden="true"
								xmlns="http://www.w3.org/2000/svg"
								fill="currentColor"
								viewBox="0 0 22 20"
							>
								<path
									d="M20.924 7.625a1.523 1.523 0 0 0-1.238-1.044l-5.051-.734-2.259-4.577a1.534 1.534 0 0 0-2.752 0L7.365 5.847l-5.051.734A1.535 1.535 0 0 0 1.463 9.2l3.656 3.563-.863 5.031a1.532 1.532 0 0 0 2.226 1.616L11 17.033l4.518 2.375a1.534 1.534 0 0 0 2.226-1.617l-.863-5.03L20.537 9.2a1.523 1.523 0 0 0 .387-1.575Z"
								/>
							</svg>
							<svg
								class="w-4 h-4 text-yellow-300 me-1"
								aria-hidden="true"
								xmlns="http://www.w3.org/2000/svg"
								fill="currentColor"
								viewBox="0 0 22 20"
							>
								<path
									d="M20.924 7.625a1.523 1.523 0 0 0-1.238-1.044l-5.051-.734-2.259-4.577a1.534 1.534 0 0 0-2.752 0L7.365 5.847l-5.051.734A1.535 1.535 0 0 0 1.463 9.2l3.656 3.563-.863 5.031a1.532 1.532 0 0 0 2.226 1.616L11 17.033l4.518 2.375a1.534 1.534 0 0 0 2.226-1.617l-.863-5.03L20.537 9.2a1.523 1.523 0 0 0 .387-1.575Z"
								/>
							</svg>
							<svg
								class="w-4 h-4 text-yellow-300 me-1"
								aria-hidden="true"
								xmlns="http://www.w3.org/2000/svg"
								fill="currentColor"
								viewBox="0 0 22 20"
							>
								<path
									d="M20.924 7.625a1.523 1.523 0 0 0-1.238-1.044l-5.051-.734-2.259-4.577a1.534 1.534 0 0 0-2.752 0L7.365 5.847l-5.051.734A1.535 1.535 0 0 0 1.463 9.2l3.656 3.563-.863 5.031a1.532 1.532 0 0 0 2.226 1.616L11 17.033l4.518 2.375a1.534 1.534 0 0 0 2.226-1.617l-.863-5.03L20.537 9.2a1.523 1.523 0 0 0 .387-1.575Z"
								/>
							</svg>
							<svg
								class="w-4 h-4 text-gray-300 me-1 dark:text-gray-500"
								aria-hidden="true"
								xmlns="http://www.w3.org/2000/svg"
								fill="currentColor"
								viewBox="0 0 22 20"
							>
								<path
									d="M20.924 7.625a1.523 1.523 0 0 0-1.238-1.044l-5.051-.734-2.259-4.577a1.534 1.534 0 0 0-2.752 0L7.365 5.847l-5.051.734A1.535 1.535 0 0 0 1.463 9.2l3.656 3.563-.863 5.031a1.532 1.532 0 0 0 2.226 1.616L11 17.033l4.518 2.375a1.534 1.534 0 0 0 2.226-1.617l-.863-5.03L20.537 9.2a1.523 1.523 0 0 0 .387-1.575Z"
								/>
							</svg>
						</div>
					</div>
					<div class="justify-self-end">
						<button
							type="button"
							class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-xs px-3 py-1.5 dark:bg-blue-600 dark:hover:bg-blue-700 focus:outline-none dark:focus:ring-blue-800"
						>
							Follow
						</button>
					</div>
				</div>
				<p class="mb-8 text-base">{{ .Description }}</p>
				<div class="flex w-full justify-evenly gap-4">
					<!--
						The handler is a bare call, not the IIFE this used to
						wrap: prettier reflows a long attribute and had split
						`return false` across a line, where ASI turns it into
						`return;`. type="button" is what actually keeps the
						click inert.
					-->
					<button
						type="button"
						{{ if eq .Type "furniture" }}
							onclick="window.game.addStuff('{{ .StuffId }}',
							'{{ .ItemType }}')"
						{{ else }}
							onclick="window.game.wearAvatar('{{ .StuffId }}')"
						{{ end }}
						class="w-32 text-white bg-orange-600 hover:bg-orange-700 focus:ring-4 focus:ring-orange-300 font-medium rounded-lg text-base px-3 py-1.5 dark:bg-orange-600 dark:hover:bg-orange-700 focus:outline-none dark:focus:ring-orange-800"
					>
						{{ if eq .Type "furniture" }}
							Add to room
						{{ else }}
							Wear Avatar
						{{ end }}
					</button>
					<form
						action="/api/collections/stuff/records/{{ .StuffId }}"
						method="delete"
					>
						<!-- 
							using this hidden input supports noscript users because
							noscript users cannot make a form request with the DELETE
							method (only GET and POST), having this will let our backend
							know that they want to do a delete
							(why are we support no js users? cause we can!)
						-->
						<noscript>
							<input type="hidden" name="method" value="delete" />
						</noscript>
						<button
							hx-delete="/api/collections/stuff/records/{{ .StuffId }}"
							hx-confirm="Are you sure you want to delete this item?"
							type="submit"
							class="w-32 text-white bg-orange-600 hover:bg-orange-700 focus:ring-4 focus:ring-orange-300 font-medium rounded-lg text-base px-3 py-1.5 dark:bg-orange-600 dark:hover:bg-orange-700 focus:outline-none dark:focus:ring-orange-800"
						>
							Delete Item
						</button>
					</form>
				</div>
				{{ if .IsCreator }}
					{{ template "stuffListing" .Listing }}
				{{ end }}
			</div>
		</div>
	</div>
{{ end }}
