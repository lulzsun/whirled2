{{ define "page" }}
	<script>
		if (window._openWebPanel) window._openWebPanel();
	</script>
	<div
		class="bg-gray-50 dark:bg-gray-800 h-full w-full flex flex-col items-center"
	>
		<div class="gap-2 flex h-full w-full max-w-7xl @7xl/web:w-3/4">
			<div id="shop-sidebar">
				<div
					class="h-full p-2 overflow-y-auto bg-gray-50 dark:bg-gray-800 text-sm"
				>
					<ul class="space-y-2 font-medium">
						<li>
							<span
								class="flex items-center p-2 text-gray-900 dark:text-white"
							>
								<span class="select-none font-bold text-base">
									Shop
								</span>
							</span>
						</li>
						<li>
							<a
								href="/shop/avatars"
								hx-target="#page"
								class="select-none flex items-center p-2 text-gray-900 rounded-lg dark:text-white hover:bg-gray-100 dark:hover:bg-gray-700 group {{ if eq .Category "avatars" }}
									bg-gray-100 dark:bg-gray-700
								{{ end }}"
							>
								<svg
									class="shrink-0 w-4 h-4 text-gray-500 transition duration-75 dark:text-gray-400 group-hover:text-gray-900 dark:group-hover:text-white"
									aria-hidden="true"
									xmlns="http://www.w3.org/2000/svg"
									fill="currentColor"
									viewBox="0 0 16 16"
								>
									<path
										d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6"
									/>
								</svg>
								<span class="flex-1 ms-3 whitespace-nowrap">
									Avatars
								</span>
							</a>
						</li>
						<li>
							<a
								href="/shop/furniture"
								hx-target="#page"
								class="select-none flex items-center p-2 text-gray-900 rounded-lg dark:text-white hover:bg-gray-100 dark:hover:bg-gray-700 group {{ if eq .Category "furniture" }}
									bg-gray-100 dark:bg-gray-700
								{{ end }}"
							>
								<svg
									class="shrink-0 w-4 h-4 text-gray-500 transition duration-75 dark:text-gray-400 group-hover:text-gray-900 dark:group-hover:text-white"
									aria-hidden="true"
									xmlns="http://www.w3.org/2000/svg"
									fill="currentColor"
									viewBox="0 0 16 16"
								>
									<path
										fill-rule="evenodd"
										d="M5.04.303A.5.5 0 0 1 5.5 0h5c.2 0 .38.12.46.303l3 7a.5.5 0 0 1-.363.687h-.002q-.225.044-.45.081a33 33 0 0 1-4.645.425V13.5a.5.5 0 1 1-1 0V8.495a33 33 0 0 1-4.645-.425q-.225-.036-.45-.08h-.003a.5.5 0 0 1-.362-.688l3-7Z"
									/>
									<path
										d="M6.493 12.574a.5.5 0 0 1-.411.575c-.712.118-1.28.295-1.655.493a1.3 1.3 0 0 0-.37.265.3.3 0 0 0-.052.075l-.001.004-.004.01V14l.002.008.016.033a.6.6 0 0 0 .145.15c.165.13.435.27.813.395.751.25 1.82.414 3.024.414s2.273-.163 3.024-.414c.378-.126.648-.265.813-.395a.6.6 0 0 0 .146-.15l.015-.033L12 14v-.004a.3.3 0 0 0-.057-.09 1.3 1.3 0 0 0-.37-.264c-.376-.198-.943-.375-1.655-.493a.5.5 0 1 1 .164-.986c.77.127 1.452.328 1.957.594C12.5 13 13 13.4 13 14c0 .426-.26.752-.544.977-.29.228-.68.413-1.116.558-.878.293-2.059.465-3.34.465s-2.462-.172-3.34-.465c-.436-.145-.826-.33-1.116-.558C3.26 14.752 3 14.426 3 14c0-.599.5-1 .961-1.243.505-.266 1.187-.467 1.957-.594a.5.5 0 0 1 .575.411"
									/>
								</svg>
								<span class="flex-1 ms-3 whitespace-nowrap">
									Furniture
								</span>
							</a>
						</li>
						<li>
							<a
								href="/shop/backdrops"
								hx-target="#page"
								class="select-none flex items-center p-2 text-gray-900 rounded-lg dark:text-white hover:bg-gray-100 dark:hover:bg-gray-700 group {{ if eq .Category "backdrops" }}
									bg-gray-100 dark:bg-gray-700
								{{ end }}"
							>
								<svg
									class="shrink-0 w-4 h-4 text-gray-500 transition duration-75 dark:text-gray-400 group-hover:text-gray-900 dark:group-hover:text-white"
									aria-hidden="true"
									xmlns="http://www.w3.org/2000/svg"
									fill="currentColor"
									viewBox="0 0 16 16"
								>
									<path
										d="M6.002 5.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0"
									/>
									<path
										d="M2.002 1a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2zm12 1a1 1 0 0 1 1 1v6.5l-3.777-1.947a.5.5 0 0 0-.577.093l-3.71 3.71-2.66-1.772a.5.5 0 0 0-.63.062L1.002 12V3a1 1 0 0 1 1-1z"
									/>
								</svg>
								<span class="flex-1 ms-3 whitespace-nowrap">
									Backdrops
								</span>
							</a>
						</li>
						<li>
							<a
								href="/shop/games"
								hx-target="#page"
								class="select-none flex items-center p-2 text-gray-900 rounded-lg dark:text-white hover:bg-gray-100 dark:hover:bg-gray-700 group {{ if eq .Category "games" }}
									bg-gray-100 dark:bg-gray-700
								{{ end }}"
							>
								<svg
									class="shrink-0 w-4 h-4 text-gray-500 transition duration-75 dark:text-gray-400 group-hover:text-gray-900 dark:group-hover:text-white"
									aria-hidden="true"
									xmlns="http://www.w3.org/2000/svg"
									fill="currentColor"
									viewBox="0 0 16 16"
								>
									<path
										d="M10 2a2 2 0 0 1-1.5 1.937v5.087c.863.083 1.5.377 1.5.726 0 .414-.895.75-2 .75s-2-.336-2-.75c0-.35.637-.643 1.5-.726V3.937A2 2 0 1 1 10 2"
									/>
									<path
										d="M0 9.665v1.717a1 1 0 0 0 .553.894l6.553 3.277a2 2 0 0 0 1.788 0l6.553-3.277a1 1 0 0 0 .553-.894V9.665c0-.1-.06-.19-.152-.23L9.5 6.715v.993l5.227 2.178a.125.125 0 0 1 .001.23l-5.94 2.546a2 2 0 0 1-1.576 0l-5.94-2.546a.125.125 0 0 1 .001-.23L6.5 7.708l-.013-.988L.152 9.435a.25.25 0 0 0-.152.23"
									/>
								</svg>
								<span class="flex-1 ms-3 whitespace-nowrap">
									Games
								</span>
							</a>
						</li>
					</ul>
				</div>
			</div>
			<div class="p-2 w-full bg-gray-50 dark:bg-gray-900 overflow-y-auto">
				{{ if .Featured }}
					<div
						class="mb-2 w-full rounded-lg border-2 border-gray-200 dark:border-gray-700 p-3 select-none"
					>
						<span
							class="text-sm font-bold text-gray-900 dark:text-white capitalize"
						>
							Featured
							{{ .Category }}
						</span>
						<div class="flex gap-4 pt-2 overflow-x-auto text-xs">
							{{ range $item := .Featured }}
								<div
									class="flex items-center gap-2 p-2 rounded-lg bg-gray-100 dark:bg-gray-800"
								>
									<img
										class="rounded-lg h-16 w-16 object-scale-down"
										{{ if $item.Thumbnail }}
											src="/api/files/{{ $.Category }}/{{ $item.ItemId }}/{{ $item.Thumbnail }}?thumb=420x420"
										{{ else }}
											src="/static/assets/{{ $.Category }}/thumb.png"
										{{ end }}
										alt="{{ $item.Name }} thumbnail"
									/>
									<div class="flex flex-col gap-1">
										<span class="font-bold truncate">
											{{ $item.Name }}
										</span>
										<span
											class="inline-flex items-center gap-1 text-gray-500 dark:text-gray-400"
										>
											<svg
												class="w-3 h-3 text-yellow-400"
												aria-hidden="true"
												xmlns="http://www.w3.org/2000/svg"
												fill="currentColor"
												viewBox="0 0 16 16"
											>
												<path
													d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2"
												/>
											</svg>
											{{ if $item.Price }}
												{{ $item.Price }} coins
											{{ else }}
												Free
											{{ end }}
										</span>
									</div>
								</div>
							{{ end }}
						</div>
					</div>
				{{ end }}
				<div
					class="flex place-content-between place-items-center space-x-2 py-2"
				>
					<div>
						<span
							class="select-none font-bold text-base capitalize"
						>
							{{ .Category }}
						</span>
						<button
							data-drawer-target="shop-sidebar"
							data-drawer-toggle="shop-sidebar"
							aria-controls="shop-sidebar"
							type="button"
							class="inline-flex items-center p-2 text-sm text-gray-500 rounded-lg sm:hidden hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200 dark:text-gray-400 dark:hover:bg-gray-700 dark:focus:ring-gray-600"
						>
							<span class="sr-only">Open sidebar</span>
							<svg
								class="w-3.5 h-3.5"
								aria-hidden="true"
								fill="none"
								viewBox="0 0 10 6"
								xmlns="http://www.w3.org/2000/svg"
							>
								<path
									stroke="currentColor"
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="m1 1 4 4 4-4"
								/>
							</svg>
						</button>
					</div>
					<div class="max-w-lg flex gap-2">
						<form
							method="get"
							action="/shop/{{ .Category }}"
							hx-target="#page"
							class="flex"
						>
							<select
								name="sort"
								onchange="this.form.requestSubmit()"
								class="shrink-0 cursor-pointer py-1.5 px-2 text-xs font-medium text-gray-900 bg-gray-100 border border-gray-300 rounded-s-lg hover:bg-gray-200 focus:ring-4 focus:outline-none focus:ring-gray-100 dark:bg-gray-700 dark:hover:bg-gray-600 dark:focus:ring-gray-700 dark:text-white dark:border-gray-600"
							>
								<option
									value="new"
									{{ if eq .Sort "new" }}selected{{ end }}
								>
									Sort by new
								</option>
								<option
									value="popular"
									{{ if eq .Sort "popular" }}selected{{ end }}
								>
									Most popular
								</option>
								<option
									value="price"
									{{ if eq .Sort "price" }}selected{{ end }}
								>
									Price: low to high
								</option>
							</select>
							<div class="relative w-full">
								<input
									type="search"
									disabled
									class="block p-1.5 w-full z-20 text-xs text-gray-900 bg-gray-50 rounded-e-lg border-s-gray-50 border-s-2 border border-gray-300 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-s-gray-700  dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:border-blue-500 cursor-not-allowed"
									placeholder="Search"
								/>
								<button
									type="button"
									class="cursor-pointer absolute top-0 end-0 p-1.5 text-xs font-medium h-full text-white bg-blue-700 rounded-e-lg border border-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"
								>
									<svg
										class="w-4 h-4"
										aria-hidden="true"
										xmlns="http://www.w3.org/2000/svg"
										fill="none"
										viewBox="0 0 20 20"
									>
										<path
											stroke="currentColor"
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z"
										/>
									</svg>
									<span class="sr-only">Search</span>
								</button>
							</div>
						</form>
					</div>
				</div>
				{{ if .Items }}
					<div
						class="text-xs grid grid-cols-6 @max-3xl/web:grid-cols-3 @max-5xl/web:grid-cols-4 gap-4"
					>
						{{ range $i, $item := .Items }}
							<div
								class="flex flex-col p-4 gap-2 border-2 border-gray-200 rounded-lg dark:border-gray-700 items-center justify-center"
							>
								<img
									class="rounded-t-lg h-auto w-[420px] object-scale-down"
									{{ if $item.Thumbnail }}
										src="/api/files/{{ $.Category }}/{{ $item.ItemId }}/{{ $item.Thumbnail }}?thumb=420x420"
									{{ else }}
										src="/static/assets/{{ $.Category }}/thumb.png"
									{{ end }}
									alt="{{ $item.Name }} thumbnail"
								/>
								<span
									class="font-bold w-full text-center truncate"
								>
									{{ $item.Name }}
								</span>
								<span
									class="w-full text-center truncate text-gray-500 dark:text-gray-400"
								>
									by
									{{ if $item.Username }}
										<a
											hx-target="#page"
											href="/profile/{{ $item.Username }}"
											class="hover:underline"
										>
											{{ $item.Nickname }}
										</a>
									{{ else }}
										Admin
									{{ end }}
								</span>
								<button
									disabled
									title="Buying is not implemented yet"
									class="cursor-not-allowed bg-gray-700 rounded-lg py-1 px-1.5 truncate inline-flex items-center gap-1 text-white"
								>
									<svg
										class="w-3 h-3 text-yellow-300"
										aria-hidden="true"
										xmlns="http://www.w3.org/2000/svg"
										fill="currentColor"
										viewBox="0 0 16 16"
									>
										<path
											d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2"
										/>
									</svg>
									{{ if $item.Price }}
										Buy &middot; {{ $item.Price }} coins
									{{ else }}
										Free
									{{ end }}
								</button>
							</div>
						{{ end }}
					</div>
				{{ else }}
					<div
						class="w-full h-40 rounded-lg border-2 border-dashed border-gray-300 dark:border-gray-700 flex flex-col items-center justify-center gap-1 select-none"
					>
						<span
							class="text-sm font-bold text-gray-400 dark:text-gray-500"
						>
							Nothing for sale here yet
						</span>
						<span class="text-xs text-gray-400 dark:text-gray-600">
							Check back later!
						</span>
					</div>
				{{ end }}
				{{ if .Pages }}
					<div class="flex justify-center py-4">
						<nav aria-label="Shop page navigation">
							<ul
								class="flex items-center -space-x-px h-8 text-sm select-none"
							>
								{{ range $p := .Pages }}
									<li>
										{{ if eq $p $.Page }}
											<span
												class="z-10 flex items-center justify-center px-3 h-8 leading-tight text-blue-600 border border-blue-300 bg-blue-50 dark:border-gray-700 dark:bg-gray-700 dark:text-white {{ if eq $p 1 }}
													rounded-l-lg
												{{ end }} {{ if eq $p (len $.Pages) }}
													rounded-r-lg
												{{ end }}"
											>
												{{ $p }}
											</span>
										{{ else }}
											<a
												hx-target="#page"
												href="/shop/{{ $.Category }}?sort={{ $.Sort }}&page={{ $p }}"
												class="flex items-center justify-center px-3 h-8 leading-tight text-gray-500 bg-white border border-gray-300 hover:bg-gray-100 hover:text-gray-700 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white {{ if eq $p 1 }}
													rounded-l-lg
												{{ end }} {{ if eq $p (len $.Pages) }}
													rounded-r-lg
												{{ end }}"
											>
												{{ $p }}
											</a>
										{{ end }}
									</li>
								{{ end }}
							</ul>
						</nav>
					</div>
				{{ end }}
			</div>
		</div>
	</div>
{{ end }}
