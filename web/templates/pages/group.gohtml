{{ define "groupMemberCount" }}
	<span
		id="group-member-count"
		{{ if .Oob }}hx-swap-oob="true"{{ end }}
		class="inline-flex items-center gap-1"
	>
		<svg
			class="w-3 h-3"
			aria-hidden="true"
			xmlns="http://www.w3.org/2000/svg"
			fill="currentColor"
			viewBox="0 0 16 16"
		>
			<path
				d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6m-5.784 6A2.24 2.24 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.3 6.3 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1zM4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5"
			/>
		</svg>
		{{ if eq .Members 1 }}
			1 member
		{{ else }}
			{{ .Members }} members
		{{ end }}
	</span>
{{ end }}

{{ define "groupJoin" }}
	<div id="group-membership" class="shrink-0 flex items-center gap-2">
		{{ if .IsAdmin }}
			<span
				class="select-none py-1 px-2 text-xs font-medium text-blue-800 bg-blue-100 rounded-lg dark:bg-blue-900 dark:text-blue-300"
			>
				Admin
			</span>
		{{ else if .IsModerator }}
			<span
				class="select-none py-1 px-2 text-xs font-medium text-green-800 bg-green-100 rounded-lg dark:bg-green-900 dark:text-green-300"
			>
				Moderator
			</span>
		{{ else if .IsMember }}
			<span
				class="select-none py-1 px-2 text-xs font-medium text-gray-800 bg-gray-100 rounded-lg dark:bg-gray-700 dark:text-gray-300"
			>
				Member
			</span>
		{{ end }}
		{{ if .AuthId }}
			{{ if .IsAdmin }}
				{{/* the admin cannot leave their own group (spec §4) */}}
			{{ else if .IsMember }}
				<button
					hx-post="/groups/{{ .Name }}/leave"
					hx-target="#group-membership"
					hx-swap="outerHTML"
					hx-disabled-elt="this"
					hx-push-url="false"
					class="cursor-pointer py-1.5 px-3 text-xs font-medium text-gray-900 bg-gray-100 rounded-lg hover:bg-gray-200 dark:bg-gray-700 dark:text-white dark:hover:bg-gray-600 disabled:opacity-50"
				>
					Leave
				</button>
			{{ else }}
				<button
					hx-post="/groups/{{ .Name }}/join"
					hx-target="#group-membership"
					hx-swap="outerHTML"
					hx-disabled-elt="this"
					hx-push-url="false"
					class="cursor-pointer py-1.5 px-3 text-xs font-medium text-white bg-blue-700 rounded-lg hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800 disabled:opacity-50"
				>
					Join
				</button>
			{{ end }}
		{{ else }}
			<a
				hx-target="#page"
				href="/login"
				class="py-1.5 px-3 text-xs font-medium text-white bg-blue-700 rounded-lg hover:bg-blue-800 dark:bg-blue-600 dark:hover:bg-blue-700"
			>
				Log in to join
			</a>
		{{ end }}
	</div>
{{ end }}

{{ define "page" }}
	<script>
		if (window._openWebPanel) window._openWebPanel();
	</script>
	<div
		class="bg-gray-50 dark:bg-gray-800 h-full w-full flex flex-col items-center"
	>
		<div class="gap-2 flex h-full w-full max-w-7xl @7xl/web:w-3/4">
			<div class="p-2 w-full bg-gray-50 dark:bg-gray-900 overflow-y-auto">
				<div class="py-2 text-xs">
					<a
						hx-target="#page"
						href="/groups"
						class="text-gray-500 dark:text-gray-400 hover:underline"
					>
						&larr; All groups
					</a>
				</div>
				<div
					class="mb-4 w-full rounded-lg border-2 border-gray-200 dark:border-gray-700 p-4 flex flex-col gap-2"
				>
					<div class="flex place-content-between gap-2">
						<div class="flex flex-col gap-1 min-w-0">
							<span
								class="font-bold text-base truncate text-gray-900 dark:text-white"
							>
								{{ .DisplayName }}
							</span>
							<span
								class="text-xs text-gray-500 dark:text-gray-400 truncate"
							>
								/groups/{{ .Name }}
							</span>
						</div>
						{{ template "groupJoin" .Membership }}
					</div>
					{{ if .Description }}
						<p class="text-xs text-gray-500 dark:text-gray-400">
							{{ .Description }}
						</p>
					{{ end }}
					<div
						class="flex gap-4 text-xs text-gray-500 dark:text-gray-400"
					>
						{{ template "groupMemberCount" .Membership }}
						{{ if .OwnerUsername }}
							<span>
								Created by
								<a
									hx-target="#page"
									href="/profile/{{ .OwnerUsername }}"
									class="hover:underline"
								>
									{{ .OwnerNickname }}
								</a>
							</span>
						{{ end }}
					</div>
				</div>
				{{/* posting is for members only (spec §4) */}}
				{{ if .Membership.IsMember }}
					<input
						type="checkbox"
						id="_create_post"
						autocomplete="off"
						class="hidden absolute"
					/>
					<style>
						#_create_post:checked ~ #_create_post_box {
							display: block;
						}
						#_create_post:checked ~ #_create_post_open {
							display: none;
						}
					</style>
					<label
						id="_create_post_open"
						for="_create_post"
						class="mb-4 cursor-pointer select-none block w-full rounded-lg border-2 border-gray-200 dark:border-gray-700 p-3 text-xs text-gray-500 dark:text-gray-400 hover:border-gray-300 dark:hover:border-gray-600"
					>
						Start a post in {{ .DisplayName }}...
					</label>
					<div
						id="_create_post_box"
						class="hidden mb-4 p-4 rounded-lg border-2 border-gray-200 dark:border-gray-700"
					>
						<form
							hx-post="/groups/{{ .Name }}/posts"
							hx-target="this"
							hx-swap="none"
							hx-push-url="false"
							class="flex flex-col gap-3 text-xs"
						>
							<input
								type="text"
								name="title"
								required
								maxlength="120"
								placeholder="Title"
								class="block p-2 w-full text-xs text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white"
							/>
							<textarea
								name="content"
								rows="5"
								maxlength="5000"
								placeholder="Text (optional)"
								class="block p-2 w-full text-xs text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white"
							></textarea>
							<div class="flex gap-2">
								<button
									type="submit"
									hx-disabled-elt="this"
									class="cursor-pointer py-1.5 px-3 text-xs font-medium text-white bg-blue-700 rounded-lg hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800 disabled:opacity-50"
								>
									Post
								</button>
								<label
									for="_create_post"
									class="cursor-pointer select-none py-1.5 px-3 text-xs font-medium text-gray-900 bg-gray-100 rounded-lg hover:bg-gray-200 dark:bg-gray-700 dark:text-white dark:hover:bg-gray-600"
								>
									Cancel
								</label>
							</div>
						</form>
					</div>
				{{ end }}
				{{ if .Posts }}
					<div class="flex flex-col gap-2">
						{{ range $post := .Posts }}
							{{ template "postCard" $post }}
						{{ end }}
					</div>
				{{ else }}
					<div
						class="w-full h-40 rounded-lg border-2 border-dashed border-gray-300 dark:border-gray-700 flex flex-col items-center justify-center gap-1 select-none"
					>
						<span
							class="text-sm font-bold text-gray-400 dark:text-gray-500"
						>
							Nothing posted here yet
						</span>
						<span class="text-xs text-gray-400 dark:text-gray-600">
							{{ if .Membership.IsMember }}
								Be the first to post!
							{{ else if .AuthId }}
								Join this group to post.
							{{ else }}
								Log in and join this group to post.
							{{ end }}
						</span>
					</div>
				{{ end }}
				{{ if .Pages }}
					<div class="flex justify-center py-4">
						<nav aria-label="Group feed page navigation">
							<ul
								class="flex items-center -space-x-px h-8 text-sm select-none"
							>
								{{ range $p := .Pages }}
									<li>
										{{ if eq $p $.Page }}
											<span
												class="z-10 flex items-center justify-center px-3 h-8 leading-tight text-blue-600 border border-blue-300 bg-blue-50 dark:border-gray-700 dark:bg-gray-700 dark:text-white {{ if eq $p 1 }}
													rounded-l-lg
												{{ end }} {{ if eq $p (len $.Pages) }}
													rounded-r-lg
												{{ end }}"
											>
												{{ $p }}
											</span>
										{{ else }}
											<a
												hx-target="#page"
												href="/groups/{{ $.Name }}?page={{ $p }}"
												class="flex items-center justify-center px-3 h-8 leading-tight text-gray-500 bg-white border border-gray-300 hover:bg-gray-100 hover:text-gray-700 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-white {{ if eq $p 1 }}
													rounded-l-lg
												{{ end }} {{ if eq $p (len $.Pages) }}
													rounded-r-lg
												{{ end }}"
											>
												{{ $p }}
											</a>
										{{ end }}
									</li>
								{{ end }}
							</ul>
						</nav>
					</div>
				{{ end }}
			</div>
		</div>
	</div>
{{ end }}
